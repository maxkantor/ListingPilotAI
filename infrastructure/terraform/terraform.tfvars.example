aws_region   = "us-east-1"
project_name = "listingpilot"
environment  = "dev"

# Lambda deployment package generated by CI/CD or local publish step
lambda_zip_path     = "./artifacts/listingpilot-api.zip"
lambda_function_name = "api"
lambda_handler      = "ListingPilot.Api::ListingPilot.Api.LambdaEntryPoint::FunctionHandlerAsync"
lambda_runtime      = "dotnet8"
lambda_memory_size  = 1024
lambda_timeout      = 30

# API CORS
cors_allow_origins = [
  "http://localhost:3000",
  "https://your-frontend-domain.com"
]

# Optional explicit names (otherwise auto-generated)
# frontend_bucket_name_override = "listingpilot-dev-frontend"
# dynamodb_table_name_override  = "listingpilot-dev-generation-records"

# Generic SSM parameters (use for any one-off values)
ssm_plain_parameters = {
  "/listingpilot/dev/app/environment" = "dev"
}

ssm_secure_parameters = {
  "/listingpilot/dev/openai/api-key" = "replace-me"
}

openai_api_key_parameter_name = "/listingpilot/dev/openai/api-key"
storage_provider              = "dynamodb"

# ---------------------------------------------------------------
# Stripe
# These are written to SSM as dedicated named parameters.
# stripe_secret_key and stripe_webhook_secret are sensitive —
# prefer passing them via TF_VAR_stripe_secret_key env vars or a
# .tfvars file that is .gitignored.
# ---------------------------------------------------------------
stripe_secret_key      = "sk_live_..."   # or sk_test_... for dev
stripe_webhook_secret  = "whsec_..."
stripe_publishable_key = "pk_live_..."   # or pk_test_... for dev

stripe_secret_key_parameter_name      = "/listingpilot/dev/stripe/secret-key"
stripe_webhook_secret_parameter_name  = "/listingpilot/dev/stripe/webhook-secret"
stripe_publishable_key_parameter_name = "/listingpilot/dev/stripe/publishable-key"

# ---------------------------------------------------------------
# SES (leave ses_from_address blank to skip identity creation)
# ---------------------------------------------------------------
ses_from_address               = "noreply@your-domain.com"
ses_from_address_parameter_name = "/listingpilot/dev/ses/from-address"

# ---------------------------------------------------------------
# Admin bootstrap
# ---------------------------------------------------------------
admin_bootstrap_email               = "admin@your-domain.com"
admin_bootstrap_email_parameter_name = "/listingpilot/dev/admin/bootstrap-email"

# ---------------------------------------------------------------
# Cognito
# Option A — let Terraform create a new pool:
#   create_cognito = true
# Option B — supply an existing pool:
#   create_cognito       = false
#   cognito_user_pool_id = "us-east-1_XXXXXXXXX"
#   cognito_client_id    = "xxxxxxxxxxxxxxxxxxxxxxxxxx"
# ---------------------------------------------------------------
create_cognito = false
# cognito_user_pool_id = "us-east-1_example"
# cognito_client_id    = "exampleclientid"
# cognito_region       = "us-east-1"

cognito_callback_urls = ["http://localhost:3000", "https://your-frontend-domain.com"]
cognito_logout_urls   = ["http://localhost:3000", "https://your-frontend-domain.com"]

# Frontend hosting with S3 + CloudFront
create_frontend_bucket = true

# Optional Amplify pipeline
enable_amplify                          = false
amplify_app_name                        = "listingpilot-frontend"
amplify_repository_url                  = "https://github.com/your-org/ListingPilotAI"
amplify_branch_name                     = "main"
amplify_github_token_ssm_parameter_name = "/listingpilot/dev/amplify/github-token"

# Optional extra tags
tags = {
  Owner = "platform-team"
}
